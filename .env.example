################################################################################
# ENVIRONMENT SETUP
#
# * commented out lines are the default
################################################################################

DOMAIN_NAME=homelab.example.tld

COMPOSE_PROFILES="default"   # basic | default (basic + traefik, tailscale) | full, plus any single profile
COMPOSE_PROJECT_NAME="homelab"

# Uncomment to also publish the web UIs on the host (see HOST PORTS at the bottom)
# COMPOSE_FILE=docker-compose.yaml:docker-compose.ports.yaml

TZ="Asia/Singapore"
PUID="1000"
PGID="1000"
# Host GID of the `render` group, for Plex hardware transcoding: getent group render | cut -d: -f3
# RENDER_GID=104

PLEX_CLAIM=""              # fresh token from https://www.plex.tv/claim (valid ~4 min), first run only
# PLEX_PORT=32400          # host port; Plex clients expect 32400, change only if it clashes
PLEX_PUBLIC_PORT=32400     # port advertised for remote access via PUBLIC_DOMAIN
HOMARR_SECRET_ENCRYPTION_KEY=""  # Required: 64 hex chars (openssl rand -hex 32)
TRACEARR_JWT_SECRET=""  # Required: 64 hex chars (openssl rand -hex 32)
TRACEARR_COOKIE_SECRET=""  # Required: 64 hex chars (openssl rand -hex 32)
# TRACEARR_DB_PASSWORD=tracearr

# Sonarr/Radarr/Prowlarr/Bazarr API keys. Pinned here so they survive a config reset and so
# Configarr can reach both instances. 32 hex chars each (openssl rand -hex 16).
# Leave empty to let each app generate its own key (Configarr then won't run).
SONARR_API_KEY=""
RADARR_API_KEY=""
PROWLARR_API_KEY=""
BAZARR_API_KEY=""

# Set together with a profile that runs Tinyauth (auth, tinyauth or full), and remove both together;
# scripts/setup-env.sh sets it when you add the profile. The protected apps' Traefik routers then
# require the Tinyauth login (404 while Tinyauth is down), and Sonarr, Radarr and Prowlarr switch to
# the External login method, which turns off their own login. Anything that skips Tinyauth, such as
# the ports overlay, then reaches them with no login. Clearing it does not restore their login
# method; set it back in each app.
# TINYAUTH_ENABLED=true

# UNIVERSAL_RESTART_POLICY="unless-stopped"

##################################################################
# TRAEFIK (profile: traefik)
#
# Traefik requests a single wildcard cert for ${DOMAIN_NAME} + *.${DOMAIN_NAME}
# via the Cloudflare DNS-01 challenge. Create a scoped API token with
# Zone:DNS:Edit on the zone and paste it into CF_DNS_API_TOKEN. DDNS Updater
# uses the same token to keep PUBLIC_DOMAIN on the home's public IP. If
# PUBLIC_DOMAIN lives in a different zone, give the token access to both.
##################################################################
CF_DNS_API_TOKEN=""
CF_ZONE_ID=""                # Cloudflare > your domain > Overview > Zone ID (zone holding PUBLIC_DOMAIN)
CF_API_EMAIL=""              # Let's Encrypt account email (expiry notices)
# TRAEFIK_SUBDOMAIN=traefik   # dashboard hostname: ${TRAEFIK_SUBDOMAIN}.${DOMAIN_NAME}
# TRAEFIK_PUBLIC_PORT=8443    # host port for the public entrypoint; forward WAN 443 here

# Basic auth for the Traefik dashboard. Blank = no auth. Value is "user:hash";
# generate it (every $ MUST be doubled to $$ for the .env file):
#   htpasswd -nbB admin 'yourpassword' | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=""

# Catch-all redirect: any request whose Host is NOT ${DOMAIN_NAME} or a subdomain of it
# (foreign domains, *.local, bare IP, typos) gets a 302 to this URL. Blank = disabled.
TRAEFIK_CATCHALL_URL=""             # e.g. http://192.168.18.10:9999 (NAS OS dashboard)

# Uncomment to test against the Let's Encrypt staging CA (avoids rate limits; issues untrusted certs)
# LETS_ENCRYPT_ENV="https://acme-staging-v02.api.letsencrypt.org/directory"

##################################################################
# POCKET ID (profile: auth)
#
# Passkey sign-in at https://id.${DOMAIN_NAME}. An app offers "Sign in with
# Pocket ID" only once its client secret is set; blank = the app's own login only.
# scripts/setup-env.sh generates the secrets when Pocket ID is in the profiles, and
# scripts/pocket-id-clients.sh registers the clients in Pocket ID once it is up.
# The apps' own logins keep working either way.
##################################################################
POCKET_ID_ENCRYPTION_KEY=""        # Required with the profile: 64 hex chars (openssl rand -hex 32)
POCKET_ID_STATIC_API_KEY=""        # Admin API key scripts/pocket-id-clients.sh uses to register clients (openssl rand -hex 32)
# OPEN_WEBUI_OIDC_CLIENT_ID=open-webui
OPEN_WEBUI_OIDC_CLIENT_SECRET=""   # openssl rand -hex 32
# HOMARR_OIDC_CLIENT_ID=homarr
HOMARR_OIDC_CLIENT_SECRET=""       # openssl rand -hex 32

##################################################################
# TINYAUTH (profile: auth)
#
# Login page at https://tinyauth.${DOMAIN_NAME} in front of Sonarr, Radarr, Prowlarr,
# Bazarr, Homepage, Glances, DDNS Updater and the Traefik dashboard. The *arr API
# paths skip it and still need the API key.
# Needs TINYAUTH_ENABLED=true (see the top of this file) to route the apps through it.
# Sign-in is through Pocket ID only. Run scripts/pocket-id-clients.sh once Pocket ID is
# up to register the client in Pocket ID from these values.
##################################################################
# TINYAUTH_OIDC_CLIENT_ID=tinyauth
TINYAUTH_OIDC_CLIENT_SECRET=""     # Required with the profile (openssl rand -hex 32)

##################################################################
# HOMEPAGE WIDGET CREDENTIALS (all optional)
#
# Fill in to light up the live widget on a service tile; blank = link-only tile.
##################################################################
# WEATHER_LATITUDE=1.3521           # weather widget location
# WEATHER_LONGITUDE=103.8198
PLEX_TOKEN=""                       # X-Plex-Token: https://support.plex.tv/articles/204059436
JELLYFIN_API_KEY=""                 # Jellyfin > Dashboard > API Keys
SEERR_API_KEY=""                    # Seerr > Settings > General > API Key
HOMEASSISTANT_TOKEN=""              # HA profile > Long-lived access tokens
TRACEARR_API_KEY=""                 # Tracearr settings > API key
# BAZARR_API_KEY is set in the *arr API-keys block above.
# qBittorrent WebUI login. An init script in the qbittorrent container writes it
# into the config in qBittorrent's PBKDF2 format on every start.
# The same values wire the Homepage widget and the qBittorrent download client
# in Sonarr/Radarr (via Configarr). Blank = manage the password in the UI, and
# Configarr can't push a usable download client.
# QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=""

##################################################################
# DIRECTORY SETUP
#
# * You must customize these paths to match your own setup
# * MEDIA_DIR must be a single root containing both media and downloads
#   subdirectories so that *arr apps can hardlink instead of copy files.
# * It is bind-mounted at /media in qBittorrent, Sonarr and Radarr.
# * Expected layout (create these before first run):
#     ${MEDIA_DIR}/Movies    -> Radarr root folder  /media/Movies
#     ${MEDIA_DIR}/Shows     -> Sonarr root folder  /media/Shows
#     ${MEDIA_DIR}/Downloads -> qBittorrent save path /media/Downloads
##################################################################
MEDIA_DIR="~/Media"
# Required. Apps with built-in scheduled backups write them to a subdirectory each
# (radarr, sonarr, prowlarr, bazarr, tracearr, homeassistant). Point your sync tool here.
BACKUP_DIR="~/Backups"
# Scratch space for Plex transcodes, mounted at /transcode. Point Plex's
# Settings > Transcoder > Transcoder temporary directory at /transcode to use it.
# PLEX_TRANSCODE_DIR="/tmp"

##################################################################
# NETWORKING VARIABLES
#
# * You must customize these variables to match your own setup
# * These are the default values for my local network
##################################################################

PHYSICAL_SERVER_IP="192.168.18.102" # ip route get 1 | awk '{print $7}')
PHYSICAL_SERVER_NETWORK="192.168.18.0/24" # advertised by Tailscale as a subnet route (TS_ROUTES)
# DOCKER_NETWORK_CIDR=172.16.0.0/12   # traefik Docker network subnet, trusted as a proxy; setup-env.sh reads it once the network exists
PUBLIC_DOMAIN=public.example.tld   # Cloudflare hostname DDNS Updater keeps on your public IP; Plex remote access and public routers
TAILSCALE_TOKEN=""                  # auth key: Tailscale admin > Settings > Keys > Generate auth key
PIHOLE_PASSWORD=""                  # Pi-hole web admin password (profile: pihole); blank = random each start

# qBittorrent / gluetun ports
# QBITTORRENT_PORT=8081
# When using custom WireGuard: set TORRENT_PORT to the forwarded port assigned by your VPN server
# When using NordVPN: leave as default or check gluetun's port-forwarding API
# TORRENT_PORT=6881

# VPN provider config lives in .env.gluetun (symlink → .env.gluetun.nordvpn or .env.gluetun.wireguard)
# See .env.gluetun.example for the template, then point the symlink at the provider you want

##################################################################
# HOST PORTS (docker-compose.ports.yaml)
#
# Only published when COMPOSE_FILE loads the overlay; otherwise the UIs are
# reachable through Traefik or Tailscale only.
##################################################################
# OLLAMA_PORT=11434
# OPEN_WEBUI_PORT=3000
# JELLYFIN_PORT=8096
# JELLYFIN_HTTPS_PORT=8920
# PROWLARR_PORT=9696
# RADARR_PORT=7878
# SONARR_PORT=8989
# BAZARR_PORT=6767
# TRACEARR_PORT=3001
# SEERR_PORT=5055
# DDNS_UPDATER_PORT=8001
# PIHOLE_WEB_PORT=81
# POCKET_ID_PORT=1411
# HOMEPAGE_PORT=3002
# HOMARR_PORT=7575
# GLANCES_PORT=61208
