# Gluetun VPN configuration template
# Do NOT commit the real files (.env.gluetun, .env.gluetun.nordvpn, .env.gluetun.wireguard)
#
# Setup:
#   cp .env.gluetun.example .env.gluetun.nordvpn    # fill in NordVPN values
#   cp .env.gluetun.example .env.gluetun.wireguard  # fill in custom WireGuard values
#   ln -sf .env.gluetun.nordvpn .env.gluetun        # make one active (or .wireguard)

# TZ and FIREWALL_OUTBOUND_SUBNETS (LAN access while the VPN is up) come from TZ and
# PHYSICAL_SERVER_NETWORK in .env, so this file only holds the provider settings.

# ---------------------------------------------------------------------------
# NordVPN via OpenVPN
# Credentials: NordVPN dashboard → "Set up NordVPN manually" → service credentials
# ---------------------------------------------------------------------------
# VPN_SERVICE_PROVIDER=nordvpn
# VPN_TYPE=openvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=
# SERVER_COUNTRIES=Netherlands

# ---------------------------------------------------------------------------
# Custom WireGuard
# Pull values from the .conf file generated by your WireGuard server
# ---------------------------------------------------------------------------
# VPN_SERVICE_PROVIDER=custom
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=    # [Interface] PrivateKey
# WIREGUARD_ADDRESSES=      # [Interface] Address  (e.g. 10.66.66.2/32)
# WIREGUARD_PUBLIC_KEY=     # [Peer] PublicKey
# VPN_ENDPOINT_IP=          # [Peer] Endpoint host
# VPN_ENDPOINT_PORT=        # [Peer] Endpoint port
